---
// ITG-1215: thin front-door stub for studio.itgo.dk's kunde-selvbetjenings-editor.
// Every ITGo Studio site scaffolded from this template gets this file — forwards the
// login.itgo.dk token to studio.itgo.dk/admin with &home= for correct re-login redirect
// on expiry. Replaces the old direct Sveltia-via-gateway mount (gateway.studio.itgo.dk +
// studio.itgo.dk/sveltia-cms.js), which is being decommissioned (ITG-1215).
const STUDIO_APP = "https://studio.itgo.dk/admin";
const LOGIN = "https://login.itgo.dk";
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ITGo Studio — Editor</title>
  </head>
  <body>
    <div style="font:15px system-ui,sans-serif;color:#5a5a6c;padding:40px;text-align:center">Sender dig til editoren…</div>
    <script is:inline define:vars={{ STUDIO_APP, LOGIN }}>
      (function () {
        var home = location.origin + location.pathname;
        var m = location.hash.match(/itgo_token=([^&]+)/);
        if (m) {
          location.replace(STUDIO_APP + "#itgo_token=" + m[1] + "&home=" + encodeURIComponent(home));
        } else {
          location.replace(LOGIN + "/?studio_redirect=" + encodeURIComponent(home));
        }
      })();
    </script>
  </body>
</html>
