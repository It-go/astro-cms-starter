---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const news = await getCollection("news");
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary} locale="da">
  <section>
    <p><a href="/nyheder">← Nyheder</a></p>
    <h1>{entry.data.title}</h1>
    <time datetime={entry.data.date.toISOString()} style="color:#666">
      {entry.data.date.toLocaleDateString("da-DK", { year: "numeric", month: "long", day: "numeric" })}
    </time>
    <article class="st-richtext" style="margin-top:16px"><Content /></article>
  </section>
</Base>
