---
// data-st-form hookes af forms→Leads-endpoint (Phase D).
interface Field {
  name: string;
  label?: string;
  type?: "text" | "email" | "tel" | "textarea";
  required?: boolean;
}
interface Props {
  heading?: string;
  submit_label?: string;
  form_key?: string;
  fields?: Field[];
  _idx?: number;
}
const { heading, submit_label = "Send", form_key = "contact", fields = [], _idx } = Astro.props;
const allowed = ["email", "tel", "text"];
// Live-preview-binding (ITG-933): data-itgo-field matcher Sveltia keyPath "blocks.<idx>.<felt>".
const fp = (f: string) => `blocks.${_idx}.${f}`;
---
<section class="st-contact" id="kontakt">
  {heading && <h2 data-itgo-field={fp("heading")}>{heading}</h2>}
  <form class="st-form" method="post" data-st-form={form_key}>
    {fields.map((f, j) => (
      <>
        <label data-itgo-field={fp(`fields.${j}.label`)}>{f.label ?? f.name}</label>
        {f.type === "textarea" ? (
          <textarea name={f.name} required={f.required} />
        ) : (
          <input type={allowed.includes(f.type ?? "") ? f.type : "text"} name={f.name} required={f.required} />
        )}
      </>
    ))}
    <button type="submit" data-itgo-field={fp("submit_label")}>{submit_label}</button>
  </form>
</section>
