---
interface Props {
  heading?: string;
  items?: { quote: string; author?: string }[];
  _idx?: number;
}
const { heading, items = [], _idx } = Astro.props;
// Live-preview-binding (ITG-933): data-itgo-field matcher Sveltia keyPath "blocks.<idx>.<felt>".
const fp = (f: string) => `blocks.${_idx}.${f}`;
---
<section class="st-testimonials">
  {heading && <h2 data-itgo-field={fp("heading")}>{heading}</h2>}
  {items.map((t, j) => (
    <blockquote>
      <span data-itgo-field={fp(`items.${j}.quote`)}>{t.quote}</span>
      <cite data-itgo-field={fp(`items.${j}.author`)}>{t.author ?? ""}</cite>
    </blockquote>
  ))}
</section>
