---
import { safeUrl } from "./safe";
interface Props {
  heading?: string;
  body?: string;
  button_label?: string;
  button_href?: string;
  _idx?: number;
}
const { heading, body, button_label, button_href, _idx } = Astro.props;
const fp = (f: string) => `blocks.${_idx}.${f}`;
---
<section class="st-cta">
  <h2 data-itgo-field={fp("heading")}>{heading}</h2>
  {body && <p data-itgo-field={fp("body")}>{body}</p>}
  {button_label && <a class="st-btn" href={safeUrl(button_href)} data-itgo-field={fp("button_label")}>{button_label}</a>}
</section>
