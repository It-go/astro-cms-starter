---
// PACK-CLUB (ITG-775): seneste nyheder — trækker direkte fra `news`-collection (GROWTH-4 /
// ITG-981) i stedet for en dubleret manuel liste. Defensiv: hvis kunden endnu ikke har
// oprettet nyheder (tom collection), vises blot en tom-tilstand — intet build-crash.
import { getCollection } from "astro:content";
import { publishedSorted, type NewsEntry } from "../../lib/news";

interface Props {
  heading?: string;
  limit?: number;
  _idx?: number;
}
const { heading, limit = 3, _idx } = Astro.props;
// Live-preview-binding (ITG-933): data-itgo-field matcher Sveltia keyPath "blocks.<idx>.<felt>".
const fp = (f: string) => `blocks.${_idx}.${f}`;

let items: NewsEntry[] = [];
try {
  items = publishedSorted(await getCollection("news")).slice(0, Math.max(1, limit));
} catch {
  items = [];
}
---
<section class="st-newsfeed">
  {heading && <h2 data-itgo-field={fp("heading")}>{heading}</h2>}
  {items.length > 0 ? (
    <ul class="st-newsfeed-list">
      {items.map((n) => (
        <li>
          <a href={`/nyheder/${n.id}`}>
            <span class="st-newsfeed-title">{n.data.title}</span>
            <time datetime={n.data.date.toISOString()}>
              {n.data.date.toLocaleDateString("da-DK", { year: "numeric", month: "long", day: "numeric" })}
            </time>
          </a>
          {n.data.summary && <p>{n.data.summary}</p>}
        </li>
      ))}
    </ul>
  ) : (
    <p class="st-newsfeed-empty">Ingen nyheder endnu.</p>
  )}
</section>

<style>
  .st-newsfeed-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px; }
  .st-newsfeed-list a { display: flex; justify-content: space-between; gap: 12px; text-decoration: none; color: inherit; font-weight: 600; }
  .st-newsfeed-list time { color: var(--st-color-muted); font-weight: 400; white-space: nowrap; }
  .st-newsfeed-list p { margin: 4px 0 0; color: var(--st-color-muted); }
  .st-newsfeed-empty { color: var(--st-color-muted); }
</style>
