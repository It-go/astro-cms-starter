---
interface Props {
  heading?: string;
  items?: { q: string; a: string }[];
  _idx?: number;
}
const { heading, items = [], _idx } = Astro.props;
// Live-preview-binding (ITG-933): data-itgo-field matcher Sveltia keyPath "blocks.<idx>.<felt>".
const fp = (f: string) => `blocks.${_idx}.${f}`;
---
<section class="st-faq">
  {heading && <h2 data-itgo-field={fp("heading")}>{heading}</h2>}
  {items.map((it, j) => (
    <details>
      <summary data-itgo-field={fp(`items.${j}.q`)}>{it.q}</summary>
      <div data-itgo-field={fp(`items.${j}.a`)}>{it.a}</div>
    </details>
  ))}
</section>
