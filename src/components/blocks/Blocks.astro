---
// Block-dispatcher: render en ordnet liste af typede blocks.
import type { Block } from "../../content.config";
import Hero from "./Hero.astro";
import Text from "./Text.astro";
import ImageGrid from "./ImageGrid.astro";
import Faq from "./Faq.astro";
import ContactForm from "./ContactForm.astro";
import Testimonials from "./Testimonials.astro";
import Cta from "./Cta.astro";
import ClickToCall from "./ClickToCall.astro";
import Reviews from "./Reviews.astro";
import Footer from "./Footer.astro";
import AreaList from "./AreaList.astro";

interface Props {
  blocks: Block[];
}
const { blocks } = Astro.props;

const MAP = {
  hero: Hero,
  text: Text,
  image_grid: ImageGrid,
  faq: Faq,
  contact_form: ContactForm,
  testimonials: Testimonials,
  cta: Cta,
  click_to_call: ClickToCall,
  reviews: Reviews,
  footer: Footer,
  area_list: AreaList,
} as const;
---
{
  blocks.map((b, i) => {
    const C = MAP[b.type];
    // @ts-expect-error — diskrimineret union: hver komponent matcher sin egen type. _idx → live-preview-felt-stier (data-itgo-field="blocks.<i>.<felt>").
    return <C {...b} _idx={i} />;
  })
}
