---
// Renderer den genererede privatlivspolitik (STD-6 / ITG-971). Data fra site-settings.
import { getSiteSettings } from "../lib/settings";
import { buildPrivacyPolicy } from "../lib/privacy";

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const site = await getSiteSettings();
const doc = buildPrivacyPolicy(site, { locale });
---

<section class="st-policy">
  <h1>{doc.title}</h1>
  <p class="st-policy-note">{doc.note}</p>
  {
    doc.sections.map((s) => (
      <div class="st-policy-section">
        <h2>{s.heading}</h2>
        {s.paragraphs?.map((p) => <p>{p}</p>)}
        {s.bullets && (
          <ul>
            {s.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        )}
      </div>
    ))
  }
  <p class="st-policy-disclaimer">{doc.disclaimer}</p>
</section>

<style>
  .st-policy { max-width: 760px; margin: 0 auto; padding: 48px 20px; }
  .st-policy h1 { font-size: 2rem; margin: 0 0 4px; }
  .st-policy-note { color: #666; margin: 0 0 24px; font-size: 0.9rem; }
  .st-policy-section { margin: 0 0 24px; }
  .st-policy-section h2 { font-size: 1.2rem; margin: 0 0 8px; }
  .st-policy-section p { margin: 0 0 8px; }
  .st-policy-section ul { margin: 0 0 8px; padding-left: 20px; }
  .st-policy-section li { margin: 2px 0; }
  .st-policy-disclaimer { margin-top: 32px; padding: 14px 16px; background: #fff8e1; border: 1px solid #f0e0a0; border-radius: 8px; font-size: 0.9rem; }
</style>
