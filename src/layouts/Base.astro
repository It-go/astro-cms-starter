---
// Basis-layout: <head> med SEO + hreflang + lang. Tailwind v4 er wired (global.css);
// brandes via @itgo/design-system i Wave 2. Indhold escapes af Astro.
import "../styles/global.css";
import { getSiteSettings } from "../lib/settings";
import { localBusinessJsonLd, breadcrumbJsonLd } from "../lib/schema-org";
import SiteHeader from "../components/SiteHeader.astro";
interface Alt {
  locale: string;
  href: string;
}
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  locale: string;
  alternates?: Alt[];
}
const { title, description, ogImage, locale, alternates = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// Globale site-indstillinger (STD-1) — altid defineret, felter kan være tomme.
const site = await getSiteSettings();
const hasSocial = !!(site.social.facebook || site.social.instagram || site.social.linkedin);
// schema.org structured data (STD-8) — LocalBusiness på alle sider, BreadcrumbList på undersider.
const base = Astro.site ?? new URL(canonical);
const businessLd = localBusinessJsonLd(site, { siteUrl: base.toString() });
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = pathname === "/" || pathname === "/en";
const breadcrumbLd = isHome
  ? null
  : breadcrumbJsonLd([
      { name: locale === "en" ? "Home" : "Forside", item: new URL(locale === "en" ? "/en" : "/", base).toString() },
      { name: title, item: canonical },
    ]);
const jsonLd = [businessLd, breadcrumbLd].filter((b): b is Record<string, unknown> => b != null);
const ldJson = (o: Record<string, unknown>) => JSON.stringify(o).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={new URL(a.href, Astro.site).toString()} />)}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="generator" content={Astro.generator} />
    {jsonLd.map((o) => <script type="application/ld+json" set:html={ldJson(o)} />)}
    <style is:global>
      * { box-sizing: border-box; }
      body { margin: 0; font: 16px/1.6 system-ui, sans-serif; color: #1a1a1a; }
      img { max-width: 100%; height: auto; display: block; }
      section { padding: 48px 20px; max-width: 1100px; margin: 0 auto; }
      .st-hero { position: relative; text-align: center; padding: 96px 20px; }
      .st-hero h1 { font-size: 2.5rem; margin: 0 0 12px; }
      .st-btn { display: inline-block; margin-top: 16px; padding: 12px 24px; background: #1a1a1a; color: #fff; text-decoration: none; border-radius: 8px; }
      .st-grid-items { display: grid; gap: 12px; }
      .st-form { display: flex; flex-direction: column; gap: 8px; max-width: 480px; }
      .st-form input, .st-form textarea { padding: 10px; border: 1px solid #ccc; border-radius: 6px; font: inherit; }
      .st-form button { padding: 12px; border: 0; background: #1a1a1a; color: #fff; border-radius: 8px; cursor: pointer; }
      .st-footer { background: #111; color: #eee; padding: 32px 20px; text-align: center; }
      .st-footer a { color: #9cf; margin: 0 8px; }
      blockquote { border-left: 3px solid #ccc; margin: 12px 0; padding: 8px 16px; }
      cite { display: block; margin-top: 8px; color: #666; }
      .st-sitefooter { background: #111; color: #cfcfcf; padding: 28px 20px; font-size: 0.95rem; }
      .st-sitefooter-inner { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 6px; text-align: center; }
      .st-sitefooter a { color: #9cf; text-decoration: none; }
      .st-sitefooter-org { font-weight: 600; color: #fff; margin: 0; }
      .st-sitefooter-contact, .st-sitefooter-social { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 16px; justify-content: center; }
      .st-sitefooter-hours { list-style: none; padding: 0; margin: 2px 0 0; display: flex; flex-wrap: wrap; gap: 2px 16px; justify-content: center; color: #9a9a9a; }
    </style>
  </head>
  <body class="antialiased">
    <SiteHeader menu={site.menu} locale={locale} pathname={Astro.url.pathname} siteName={site.company} />
    <slot />
    <footer class="st-sitefooter">
      <div class="st-sitefooter-inner">
        <p class="st-sitefooter-org">
          {site.company || "—"}{site.cvr && <span> · CVR {site.cvr}</span>}
        </p>
        {(site.address || site.phone || site.email) && (
          <p class="st-sitefooter-contact">
            {site.address && <span>{site.address}</span>}
            {site.phone && <a href={`tel:${site.phone.replace(/\s+/g, "")}`}>{site.phone}</a>}
            {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
          </p>
        )}
        {site.opening_hours.length > 0 && (
          <ul class="st-sitefooter-hours">
            {site.opening_hours.map((h) => (
              <li>{h.day}{h.hours && `: ${h.hours}`}</li>
            ))}
          </ul>
        )}
        {hasSocial && (
          <p class="st-sitefooter-social">
            {site.social.facebook && <a href={site.social.facebook} rel="noopener noreferrer">Facebook</a>}
            {site.social.instagram && <a href={site.social.instagram} rel="noopener noreferrer">Instagram</a>}
            {site.social.linkedin && <a href={site.social.linkedin} rel="noopener noreferrer">LinkedIn</a>}
          </p>
        )}
      </div>
    </footer>
    {/* ITGo live-preview-bro (ITG-929 + in-context edit ITG-960) — kun aktiv med ?itgo_preview=1.
        Tovejs: editor→preview (itgo:draft patcher [data-itgo-field]) OG preview→editor (klik-til-redigér
        i edit-mode poster itgo:edit). Fail-safe: ukendte felter/fejl ignoreres. */}
    <style is:inline>
      html[data-itgo-edit="1"] [data-itgo-field]:not(img):not([data-itgo-html]):hover { outline: 2px dashed #6b8afd; outline-offset: 2px; cursor: text; }
      html[data-itgo-edit="1"] [data-itgo-field][contenteditable="true"]:focus { outline: 2px solid #2f5bff; outline-offset: 2px; border-radius: 2px; }
      html[data-itgo-edit="1"] [data-itgo-openform]:hover { outline: 2px dashed #6b8afd; outline-offset: 2px; cursor: pointer; }
    </style>
    <script is:inline>
      (function () {
        if (new URLSearchParams(location.search).get("itgo_preview") !== "1") return;
        document.documentElement.setAttribute("data-itgo-preview", "1");
        function setVal(el, v) {
          var s = v == null ? "" : String(v);
          if (el.tagName === "IMG") el.setAttribute("src", s);
          else if (el.hasAttribute("data-itgo-html")) el.innerHTML = s;
          else el.textContent = s;
        }
        function patch(fields) {
          if (!fields || typeof fields !== "object") return;
          Object.keys(fields).forEach(function (path) {
            if (/["\\]/.test(path)) return;
            var nodes = document.querySelectorAll('[data-itgo-field="' + path + '"]');
            for (var i = 0; i < nodes.length; i++) setVal(nodes[i], fields[path]);
          });
        }
        function post(type, payload) {
          try { if (window.parent && window.parent !== window) window.parent.postMessage(Object.assign({ type: type }, payload || {}), "*"); } catch (e) {}
        }
        // ── In-context edit-mode (ITG-960): preview → editor ──────────────────
        // Plain-tekst-felter bliver klik-til-redigér; billeder + richtext (data-itgo-html)
        // åbnes i stedet i formularen (MVP — undgår at smadre rich text/binær).
        var EDIT = false;
        function inlineEditable(el) { return el.tagName !== "IMG" && !el.hasAttribute("data-itgo-html"); }
        function setEditMode(on) {
          EDIT = !!on;
          document.documentElement.setAttribute("data-itgo-edit", EDIT ? "1" : "0");
          var els = document.querySelectorAll("[data-itgo-field]");
          for (var i = 0; i < els.length; i++) {
            var el = els[i];
            if (EDIT && inlineEditable(el)) { el.setAttribute("contenteditable", "true"); el.removeAttribute("data-itgo-openform"); }
            else if (EDIT) { el.setAttribute("data-itgo-openform", "1"); }
            else { el.removeAttribute("contenteditable"); el.removeAttribute("data-itgo-openform"); }
          }
        }
        document.addEventListener("input", function (e) {
          if (!EDIT) return;
          var el = e.target && e.target.closest ? e.target.closest('[data-itgo-field][contenteditable="true"]') : null;
          if (!el) return;
          post("itgo:edit", { path: el.getAttribute("data-itgo-field"), value: el.textContent });
        }, true);
        document.addEventListener("click", function (e) {
          if (!EDIT) return;
          var el = e.target && e.target.closest ? e.target.closest("[data-itgo-openform]") : null;
          if (!el) return;
          e.preventDefault();
          post("itgo:focus-field", { path: el.getAttribute("data-itgo-field") });
        }, true);
        window.addEventListener("message", function (e) {
          var d = e.data;
          if (!d) return;
          if (d.type === "itgo:draft") { try { patch(d.fields); } catch (err) {} return; }
          if (d.type === "itgo:edit-mode") { try { setEditMode(d.on); } catch (err) {} return; }
        });
        post("itgo:preview-ready", {});
      })();
    </script>
  </body>
</html>
